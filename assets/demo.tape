# Regenerate with: vhs assets/demo.tape (from the repository root)

Output assets/demo.gif

Set Shell "bash"
Set FontSize 20
Set Width 1440
Set Height 820
Set Padding 24
Set Theme "Catppuccin Mocha"
Set TypingSpeed 45ms

Hide
Type `export D=/tmp/demo && assets/demo/setup.sh "$D" && go build -o "$D/gv" . && cd "$D" && export HOME="$D" PATH="$D:$PATH" GIT_CONFIG_NOSYSTEM=1 PS1='\[\e[1;35m\]$ \[\e[0m\]'`
Enter
Sleep 10s
Type `set +m; (sleep 21 && seq 1 80 > code/cli/main.go) >/dev/null 2>&1 & clear`
Enter
Sleep 1s
Show

Type "cat ~/.config/gv/config.yaml"
Sleep 400ms
Enter
Sleep 2s

Type "gv"
Sleep 400ms
Enter
Sleep 3s

Down
Sleep 1s
Down
Sleep 1s
Down
Sleep 1s
Down
Sleep 1.5s

Type "2"
Sleep 2s
Type "3"
Sleep 2s
Type "4"
Sleep 2s
Type "1"
Sleep 6s

Type "/"
Sleep 400ms
Type "api"
Sleep 2s
Escape
Sleep 2s
